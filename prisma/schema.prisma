// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Credentials {
  id       String @id @unique
  email    String @unique
  password String

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model User {
  id         String       @id @unique @default(uuid())
  credential Credentials?

  email       String  @unique
  username    String
  role        String  @default("guest") // roles: admin, user, guest
  accessLevel String  @default("read-only") // access levels: read-only, read-write
  initialized Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  notifications Notification[]

  config     UserConfig?
  siteConfig SiteConfig?
}

model Session {
  id     String @id @unique @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model UserConfig {
  id     String @id @unique @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  theme         String  @default("light") // light, dark
  language      String  @default("en") // en, es, fr, de, it, pt, ru, zh, ja, ko
  notifications Boolean @default(true)
  imagePreview  Boolean @default(false)
}

model SiteConfig {
  id      String @id @unique @default(uuid())
  adminID String @unique
  admin   User   @relation(fields: [adminID], references: [id], onDelete: Cascade)

  siteName        String @default("Connect")
  siteLogo        String @default("/logo.svg")
  siteFavicon     String @default("/favicon.ico")
  siteUrl         String @default("http://localhost:3000")
  siteDescription String @default("Connect - The ultimate platform for managing your applications and services.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("The site is under maintenance. Please check back later.")
  allowGuestSignup   Boolean @default(true)
  allowGuestDownload Boolean @default(false)
}

model Notification{
    id      String  @id @unique @default(uuid())
    
    message String
    ntype   String  @default("info")
    seen    Boolean @default(false)

    receiverID  String
    reciever    User    @relation(fields: [receiverID], references: [id], onDelete: Cascade)
}
